<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Zombie Battle 3D</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    user-select:none;
    -webkit-user-select:none;
}

html,body{
    width:100%;
    height:100%;
    overflow:hidden;
    background:#111;
    font-family:Arial,sans-serif;
}

#game{
    position:fixed;
    inset:0;
}

canvas{
    display:block;
}

#ui{
    position:fixed;
    inset:0;
    pointer-events:none;
    color:white;
}

#top{
    position:absolute;
    top:15px;
    left:15px;
    right:15px;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
}

.panel{
    background:rgba(0,0,0,.55);
    border:1px solid rgba(255,255,255,.2);
    border-radius:14px;
    padding:10px 14px;
    backdrop-filter:blur(5px);
}

#health{
    width:180px;
    height:14px;
    background:#333;
    border-radius:10px;
    overflow:hidden;
    margin-top:6px;
}

#healthBar{
    height:100%;
    width:100%;
    background:#25e35d;
}

#ammo{
    font-size:22px;
    font-weight:bold;
}

#crosshair{
    position:absolute;
    left:50%;
    top:50%;
    width:28px;
    height:28px;
    transform:translate(-50%,-50%);
}

#crosshair:before,
#crosshair:after{
    content:"";
    position:absolute;
    background:white;
}

#crosshair:before{
    width:2px;
    height:28px;
    left:13px;
}

#crosshair:after{
    width:28px;
    height:2px;
    top:13px;
}

#message{
    position:absolute;
    left:50%;
    top:18%;
    transform:translateX(-50%);
    font-size:28px;
    font-weight:bold;
    text-shadow:0 2px 8px black;
    text-align:center;
}

#start{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    background:linear-gradient(#07120ddd,#000b);
    pointer-events:auto;
}

#start h1{
    font-size:42px;
    margin-bottom:10px;
    text-shadow:0 4px 15px #000;
}

#start p{
    margin-bottom:25px;
    color:#ddd;
    text-align:center;
}

button{
    border:0;
    border-radius:14px;
    padding:15px 28px;
    font-size:18px;
    font-weight:bold;
    background:#19d65b;
    color:white;
}

#controls{
    position:absolute;
    inset:0;
}

#joystick{
    position:absolute;
    left:25px;
    bottom:35px;
    width:125px;
    height:125px;
    border-radius:50%;
    background:rgba(255,255,255,.12);
    border:2px solid rgba(255,255,255,.25);
    pointer-events:auto;
}

#stick{
    position:absolute;
    left:37px;
    top:37px;
    width:50px;
    height:50px;
    border-radius:50%;
    background:rgba(255,255,255,.45);
}

.controlButton{
    position:absolute;
    width:72px;
    height:72px;
    border-radius:50%;
    background:rgba(0,0,0,.55);
    border:2px solid rgba(255,255,255,.35);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:14px;
    font-weight:bold;
    pointer-events:auto;
}

#fire{
    right:28px;
    bottom:50px;
    width:95px;
    height:95px;
    background:rgba(220,40,40,.65);
}

#reload{
    right:125px;
    bottom:55px;
}

#heal{
    right:125px;
    bottom:140px;
}

#loot{
    right:30px;
    bottom:160px;
}

#sprint{
    left:165px;
    bottom:45px;
}

#stats{
    position:absolute;
    left:15px;
    bottom:15px;
    font-size:14px;
}

@media(min-width:800px){
    #controls{
        display:none;
    }
}
</style>
</head>

<body>

<div id="game"></div>

<div id="ui">

    <div id="top">

        <div class="panel">
            ❤️ HP
            <div id="health">
                <div id="healthBar"></div>
            </div>
            <div id="status">Живий</div>
        </div>

        <div class="panel">
            🔫 <span id="ammo">30</span> / <span id="reserve">120</span>
        </div>

    </div>

    <div id="crosshair"></div>

    <div id="message"></div>

    <div id="stats">
        🧟 Зомбі: <span id="zombieCount">0</span><br>
        💰 Монети: <span id="coins">0</span>
    </div>

    <div id="controls">

        <div id="joystick">
            <div id="stick"></div>
        </div>

        <div class="controlButton" id="sprint">RUN</div>
        <div class="controlButton" id="heal">❤️</div>
        <div class="controlButton" id="reload">↻</div>
        <div class="controlButton" id="loot">📦</div>
        <div class="controlButton" id="fire">FIRE</div>

    </div>

    <div id="start">
        <h1>🧟 ZOMBIE BATTLE</h1>
        <p>3D survival shooter</p>
        <button id="startButton">ПОЧАТИ ГРУ</button>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/three@0.161.0/build/three.min.js"></script>

<script>

let scene;
let camera;
let renderer;
let player;

let zombies=[];
let bullets=[];
let lootBoxes=[];

let started=false;
let health=100;
let ammo=30;
let reserve=120;
let coins=0;

let speed=0.12;
let sprinting=false;

let keys={};

let joystick={
    active:false,
    x:0,
    y:0
};

const zombieCount=document.getElementById("zombieCount");
const healthBar=document.getElementById("healthBar");
const ammoText=document.getElementById("ammo");
const reserveText=document.getElementById("reserve");
const coinsText=document.getElementById("coins");
const message=document.getElementById("message");

function init(){

    scene=new THREE.Scene();

    scene.background=new THREE.Color(0x78a8c7);

    scene.fog=new THREE.Fog(0x78a8c7,40,220);

    camera=new THREE.PerspectiveCamera(
        70,
        innerWidth/innerHeight,
        0.1,
        500
    );

    renderer=new THREE.WebGLRenderer({
        antialias:true
    });

    renderer.setSize(innerWidth,innerHeight);
    renderer.setPixelRatio(Math.min(devicePixelRatio,2));

    document.getElementById("game").appendChild(renderer.domElement);

    const light=new THREE.HemisphereLight(
        0xffffff,
        0x445544,
        2
    );

    scene.add(light);

    const sun=new THREE.DirectionalLight(
        0xffffff,
        2
    );

    sun.position.set(80,120,40);
    scene.add(sun);

    createWorld();

    createPlayer();

    createZombies(18);

    createLoot(15);

    window.addEventListener("resize",resize);

    window.addEventListener("keydown",e=>{
        keys[e.key.toLowerCase()]=true;

        if(e.key.toLowerCase()==="r") reload();

        if(e.key.toLowerCase()==="h") heal();

        if(e.key===" ") shoot();
    });

    window.addEventListener("keyup",e=>{
        keys[e.key.toLowerCase()]=false;
    });

    setupControls();

    animate();
}

function createWorld(){

    const groundGeometry=new THREE.PlaneGeometry(
        400,
        400
    );

    const groundMaterial=new THREE.MeshStandardMaterial({
        color:0x3c7135
    });

    const ground=new THREE.Mesh(
        groundGeometry,
        groundMaterial
    );

    ground.rotation.x=-Math.PI/2;

    scene.add(ground);

    createRoad(0,0,14,400);
    createRoad(0,0,400,14);

    for(let i=0;i<35;i++){

        let x=(Math.random()-.5)*350;
        let z=(Math.random()-.5)*350;

        if(Math.abs(x)<30 || Math.abs(z)<30) continue;

        createBuilding(x,z);
    }

    for(let i=0;i<90;i++){

        let x=(Math.random()-.5)*370;
        let z=(Math.random()-.5)*370;

        createTree(x,z);
    }
}

function createRoad(x,z,w,d){

    const geo=new THREE.BoxGeometry(w,.08,d);

    const mat=new THREE.MeshStandardMaterial({
        color:0x292929
    });

    const road=new THREE.Mesh(geo,mat);

    road.position.set(x,.04,z);

    scene.add(road);
}

function createBuilding(x,z){

    const w=8+Math.random()*8;
    const h=5+Math.random()*8;
    const d=8+Math.random()*8;

    const geo=new THREE.BoxGeometry(w,h,d);

    const mat=new THREE.MeshStandardMaterial({
        color:0x777777
    });

    const building=new THREE.Mesh(geo,mat);

    building.position.set(
        x,
        h/2,
        z
    );

    scene.add(building);
}

function createTree(x,z){

    const trunkGeo=new THREE.CylinderGeometry(
        .4,
        .6,
        4,
        8
    );

    const trunkMat=new THREE.MeshStandardMaterial({
        color:0x6b4324
    });

    const trunk=new THREE.Mesh(
        trunkGeo,
        trunkMat
    );

    trunk.position.set(x,2,z);

    scene.add(trunk);

    const crownGeo=new THREE.SphereGeometry(
        2.5,
        8,
        8
    );

    const crownMat=new THREE.MeshStandardMaterial({
        color:0x1c6e31
    });

    const crown=new THREE.Mesh(
        crownGeo,
        crownMat
    );

    crown.position.set(x,5,z);

    scene.add(crown);
}

function createPlayer(){

    player=new THREE.Group();

    const bodyGeo=new THREE.CapsuleGeometry(
        .55,
        1.3,
        5,
        10
    );

    const bodyMat=new THREE.MeshStandardMaterial({
        color:0x2468a8
    });

    const body=new THREE.Mesh(
        bodyGeo,
        bodyMat
    );

    body.position.y=1.2;

    player.add(body);

    const headGeo=new THREE.SphereGeometry(
        .45,
        16,
        16
    );

    const headMat=new THREE.MeshStandardMaterial({
        color:0xffc39a
    });

    const head=new THREE.Mesh(
        headGeo,
        headMat
    );

    head.position.y=2.3;

    player.add(head);

    const gunGeo=new THREE.BoxGeometry(
        .18,
        .18,
        1.5
    );

    const gunMat=new THREE.MeshStandardMaterial({
        color:0x171717
    });

    const gun=new THREE.Mesh(
        gunGeo,
        gunMat
    );

    gun.position.set(
        .6,
        1.35,
        -.7
    );

    gun.rotation.x=-.1;

    player.add(gun);

    player.position.set(
        0,
        0,
        0
    );

    scene.add(player);
}

function createZombie(x,z){

    const zombie=new THREE.Group();

    const bodyGeo=new THREE.CapsuleGeometry(
        .55,
        1.2,
        5,
        8
    );

    const bodyMat=new THREE.MeshStandardMaterial({
        color:0x5a9250
    });

    const body=new THREE.Mesh(
        bodyGeo,
        bodyMat
    );

    body.position.y=1.15;

    zombie.add(body);

    const headGeo=new THREE.SphereGeometry(
        .48,
        12,
        12
    );

    const headMat=new THREE.MeshStandardMaterial({
        color:0x6e9d59
    });

    const head=new THREE.Mesh(
        headGeo,
        headMat
    );

    head.position.y=2.25;

    zombie.add(head);

    zombie.position.set(x,0,z);

    zombie.userData={
        hp:100,
        speed:.025+Math.random()*.018,
        attackTimer:0
    };

    scene.add(zombie);

    zombies.push(zombie);
}

function createZombies(amount){

    for(let i=0;i<amount;i++){

        const angle=Math.random()*Math.PI*2;
        const distance=30+Math.random()*100;

        createZombie(
            Math.cos(angle)*distance,
            Math.sin(angle)*distance
        );
    }

    updateZombieCount();
}

function createLoot(amount){

    for(let i=0;i<amount;i++){

        const geo=new THREE.BoxGeometry(
            1,
            .7,
            1
        );

        const mat=new THREE.MeshStandardMaterial({
            color:0xe6b52f
        });

        const box=new THREE.Mesh(
            geo,
            mat
        );

        box.position.set(
            (Math.random()-.5)*300,
            .4,
            (Math.random()-.5)*300
        );

        box.userData={
            type:"ammo"
        };

        scene.add(box);

        lootBoxes.push(box);
    }
}

function shoot(){

    if(!started) return;

    if(ammo<=0){

        showMessage("Потрібно перезарядити!");

        return;
    }

    ammo--;

    updateUI();

    const raycaster=new THREE.Raycaster();

    raycaster.setFromCamera(
        new THREE.Vector2(0,0),
        camera
    );

    const targets=[];

    zombies.forEach(z=>{
        z.traverse(obj=>{
            if(obj.isMesh) targets.push(obj);
        });
    });

    const hits=raycaster.intersectObjects(
        targets,
        false
    );

    if(hits.length){

        let object=hits[0].object;

        let target=null;

        while(object.parent){

            if(zombies.includes(object)){
                target=object;
                break;
            }

            object=object.parent;
        }

        if(target){

            target.userData.hp-=50;

            if(target.userData.hp<=0){

                scene.remove(target);

                zombies=zombies.filter(
                    z=>z!==target
                );

                coins+=10;

                updateZombieCount();
                updateUI();

                showMessage("+10 💰");
            }
        }
    }
}

function reload(){

    if(reserve<=0 || ammo>=30) return;

    const needed=30-ammo;
    const amount=Math.min(
        needed,
        reserve
    );

    ammo+=amount;
    reserve-=amount;

    updateUI();
}

function heal(){

    if(health>=100) return;

    health=Math.min(
        100,
        health+25
    );

    updateUI();
}

function collectLoot(){

    for(let i=lootBoxes.length-1;i>=0;i--){

        const box=lootBoxes[i];

        if(
            player.position.distanceTo(
                box.position
            )<4
        ){

            reserve+=30;

            scene.remove(box);

            lootBoxes.splice(i,1);

            updateUI();

            showMessage("+30 патронів");
        }
    }
}

function updateZombies(){

    zombies.forEach(z=>{

        const distance=z.position.distanceTo(
            player.position
        );

        if(distance<45){

            z.lookAt(
                player.position.x,
                z.position.y,
                player.position.z
            );

            if(distance>2){

                const direction=
                    new THREE.Vector3()
                    .subVectors(
                        player.position,
                        z.position
                    )
                    .normalize();

                z.position.add(
                    direction.multiplyScalar(
                        z.userData.speed
                    )
                );

            }else{

                z.userData.attackTimer--;

                if(z.userData.attackTimer<=0){

                    health-=5;

                    z.userData.attackTimer=60;

                    updateUI();

                    if(health<=0){

                        gameOver();
                    }
                }
            }
        }
    });
}

function movePlayer(){

    if(!started) return;

    let x=0;
    let z=0;

    if(keys["w"]) z-=1;
    if(keys["s"]) z+=1;
    if(keys["a"]) x-=1;
    if(keys["d"]) x+=1;

    x+=joystick.x;
    z+=joystick.y;

    const length=Math.sqrt(
        x*x+z*z
    );

    if(length>0){

        x/=length;
        z/=length;

        const currentSpeed=
            sprinting ? .22 : speed;

        player.position.x+=
            x*currentSpeed;

        player.position.z+=
            z*currentSpeed;
    }

    camera.position.lerp(
        new THREE.Vector3(
            player.position.x,
            player.position.y+7,
            player.position.z+10
        ),
        .12
    );

    camera.lookAt(
        player.position.x,
        player.position.y+1,
        player.position.z
    );
}

function updateUI(){

    healthBar.style.width=
        Math.max(0,health)+"%";

    ammoText.textContent=ammo;
    reserveText.textContent=reserve;
    coinsText.textContent=coins;

    if(health>60)
        healthBar.style.background="#25e35d";
    else if(health>30)
        healthBar.style.background="#f0c329";
    else
        healthBar.style.background="#e53935";
}

function updateZombieCount(){

    zombieCount.textContent=zombies.length;
}

function showMessage(text){

    message.textContent=text;

    setTimeout(()=>{
        if(message.textContent===text)
            message.textContent="";
    },1200);
}

function gameOver(){

    started=false;

    message.innerHTML=
        "💀 ТИ ПРОГРАВ<br><br>"+
        "<button onclick='location.reload()'>ЗАНОВО</button>";
}

function setupControls(){

    const joystickElement=
        document.getElementById("joystick");

    const stick=
        document.getElementById("stick");

    function updateJoystick(e){

        const rect=
            joystickElement.getBoundingClientRect();

        const touch=e.touches[0];

        let x=
            touch.clientX-
            (rect.left+rect.width/2);

        let y=
            touch.clientY-
            (rect.top+rect.height/2);

        const max=45;

        const distance=Math.sqrt(x*x+y*y);

        if(distance>max){

            x=x/distance*max;
            y=y/distance*max;
        }

        stick.style.transform=
            `translate(${x}px,${y}px)`;

        joystick.x=x/max;
        joystick.y=y/max;
    }

    joystickElement.addEventListener(
        "touchstart",
        e=>{
            e.preventDefault();
            joystick.active=true;
            updateJoystick(e);
        },
        {passive:false}
    );

    joystickElement.addEventListener(
        "touchmove",
        e=>{
            e.preventDefault();

            if(joystick.active)
                updateJoystick(e);
        },
        {passive:false}
    );

    joystickElement.addEventListener(
        "touchend",
        e=>{

            joystick.active=false;

            joystick.x=0;
            joystick.y=0;

            stick.style.transform=
                "translate(0,0)";
        }
    );

    document.getElementById("fire")
    .addEventListener(
        "touchstart",
        e=>{
            e.preventDefault();
            shoot();
        },
        {passive:false}
    );

    document.getElementById("reload")
    .addEventListener(
        "touchstart",
        e=>{
            e.preventDefault();
            reload();
        },
        {passive:false}
    );

    document.getElementById("heal")
    .addEventListener(
        "touchstart",
        e=>{
            e.preventDefault();
            heal();
        },
        {passive:false}
    );

    document.getElementById("loot")
    .addEventListener(
        "touchstart",
        e=>{
            e.preventDefault();
            collectLoot();
        },
        {passive:false}
    );

    const sprintButton=
        document.getElementById("sprint");

    sprintButton.addEventListener(
        "touchstart",
        ()=>{
            sprinting=true;
        }
    );

    sprintButton.addEventListener(
        "touchend",
        ()=>{
            sprinting=false;
        }
    );

    document.getElementById("startButton")
    .addEventListener(
        "click",
        ()=>{
            started=true;

            document.getElementById("start")
            .style.display="none";

            updateUI();
        }
    );
}

function resize(){

    camera.aspect=
        innerWidth/innerHeight;

    camera.updateProjectionMatrix();

    renderer.setSize(
        innerWidth,
        innerHeight
    );
}

function animate(){

    requestAnimationFrame(animate);

    movePlayer();

    updateZombies();

    renderer.render(
        scene,
        camera
    );
}

init();

</script>

</body>
</html>
